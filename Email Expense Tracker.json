        "jsCode": "const emailText = $json.textPlain;\n\n// Extract Amount\nconst amountMatch = emailText.match(/INR\\s([\\d.]+)/);\n\n// Extract Transaction Type (DEBITED / CREDITED)\nconst typeMatch = emailText.match(/has been\\s(\\w+)/);\n\n// Extract Account Number (last digits)\nconst accountMatch = emailText.match(/account\\sXXX(\\d+)/);\n\n// Extract Date\nconst dateMatch = emailText.match(/on\\r\\n(\\d{2}\\/\\d{2}\\/\\d{4})/);\n\nreturn [\n  {\n    json: {\n      bank: \"Canara Bank\",\n      date: dateMatch ? dateMatch[1] : \"\",\n      amount: amountMatch ? amountMatch[1] : \"\",\n      type: typeMatch ? typeMatch[1] : \"\",\n      account_last_digits: accountMatch ? accountMatch[1] : \"\"\n    }\n  }\n];\n"
