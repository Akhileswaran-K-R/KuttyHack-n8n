    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet total = 0;\nlet transactionCount = 0;\nconst monthlyTotals = {};\n\nitems.forEach(item => {\n  const date = item.json.date;\n  const amount = parseFloat(item.json.amount);\n\n  if (!date || isNaN(amount)) return;\n\n  total += amount;\n  transactionCount++;\n\n  // Extract month/year\n  const parts = date.split(\"/\");\n  const monthYear = parts[1] + \"/\" + parts[2];\n\n  if (!monthlyTotals[monthYear]) {\n    monthlyTotals[monthYear] = 0;\n  }\n\n  monthlyTotals[monthYear] += amount;\n});\n\n// Current month\nconst now = new Date();\nconst currentMonth = String(now.getMonth() + 1).padStart(2, '0');\nconst currentYear = now.getFullYear();\nconst currentMonthKey = `${currentMonth}/${currentYear}`;\nconst thisMonthTotal = monthlyTotals[currentMonthKey] || 0;\n\n// Highest spending month\nlet highestMonth = null;\nlet highestAmount = 0;\n\nfor (const [month, amount] of Object.entries(monthlyTotals)) {\n  if (amount > highestAmount) {\n    highestAmount = amount;\n    highestMonth = month;\n  }\n}\n\n// Build message\nconst summaryMessage = `\n📊 Expense Summary\n\n💰 Total: ₹${total.toFixed(2)}\n📅 This Month: ₹${thisMonthTotal.toFixed(2)}\n📈 Highest Month: ${highestMonth || \"N/A\"} (₹${highestAmount.toFixed(2)})\n🔢 Transactions: ${transactionCount}\n`;\n\nreturn [{\n  json: {\n    messageText: summaryMessage\n  }\n}];\n"
      },
