    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Group totals by month\nconst monthlyTotals = {};\n\nitems.forEach(item => {\n  const date = item.json.date;  // Make sure column name matches exactly\n  const amount = parseFloat(item.json.amount);\n\n  if (!date || isNaN(amount)) return;\n\n  // Date format assumed: DD/MM/YYYY\n  const parts = date.split(\"/\");\n  const monthYear = parts[1] + \"/\" + parts[2];  // MM/YYYY\n\n  if (!monthlyTotals[monthYear]) {\n    monthlyTotals[monthYear] = 0;\n  }\n\n  monthlyTotals[monthYear] += amount;\n});\n\n// Convert to arrays\nconst labels = Object.keys(monthlyTotals);\nconst data = Object.values(monthlyTotals);\n\n// Generate QuickChart URL\nconst chartConfig = {\n  type: 'bar',\n  data: {\n    labels: labels,\n    datasets: [{\n      label: 'Monthly Expenses',\n      data: data\n    }]\n  }\n};\n\nconst chartUrl = `https://quickchart.io/chart?c=${encodeURIComponent(JSON.stringify(chartConfig))}`;\n\nreturn [{\n  json: {\n    chartUrl: chartUrl\n  }\n}];\n"
      },
